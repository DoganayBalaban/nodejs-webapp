extends ../layouts/main-layout.pug

block content 
    if (action !== 'undefined' && action === 'update')
        div.alert.alert-success Kategori güncellendi
    
    if (action !== 'undefined' && action === 'delete')
        div.alert.alert-danger Kategori silindi
    
    
    if categories.length > 0
        table.table.table-bordered 
            thead 
                tr 
                    
                    th Category Name 
                    th(style="width:150") Description
                    th 

            tbody
                each category in categories 
                    tr 
                        
                        td #{category.name}
                        td #{category.description}
                        td 
                            a.btn.btn-primary.btn-sm.mr-2(href=`/admin/categories/${category._id}`) Edit 
                            form(action="/admin/delete-category" method="post")
                                input(type="hidden" name="id" value=`${category._id}`)
                                button(type='submit').btn.btn-danger.btn-sm Delete
    else    
        h1 No Category                    