    //-   .col-sm-10
    //-     select.form-control( name="cateoryId" id="categoryid")
    //-       option(value="-1") Select Category 
    //-       each category in categories
    //-         option(value=`${category.id}`) #{category.name}
    .form-group.row
      label.col-sm-2.col-form-label(for="description") Açıklama
      .col-sm-10
        textarea.form-control(cols="30" rows="10" name="description" id="description")
    .form-group.row
      .col-sm-10.offset-sm-2
