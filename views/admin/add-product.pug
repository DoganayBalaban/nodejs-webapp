extends ../layouts/main-layout.pug

block styles 
  link(rel="stylesheet", href="/css/form.css")

block content 
  form(action="/admin/add-product" method="POST")
    .form-group.row
      label.col-sm-2.col-form-label(for="name") Name
      .col-sm-10
        input.form-control(type="text" name="name" id="name")
    .form-group.row
      label.col-sm-2.col-form-label(for="price") Fiyat
      .col-sm-10
        input.form-control(type="text" name="price" id="price")
    .form-group.row
      label.col-sm-2.col-form-label(for="imageUrl") Resim
      .col-sm-10
        input.form-control(type="text" name="imageUrl" id="imageUrl" )
    //- .form-group.row
